# Copy to .env for local overrides. Never commit real secrets.
# Without DATABASE_URL the API uses an embedded PGlite database in .data/pglite.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=4000
DEMO_DATA=true
# Any long random string; the cron service sends it in the X-Cron-Secret header.
CRON_SECRET=
# First admin account, created on start if this email has no account yet. Set these in the
# host's dashboard (Render → Environment); after your first sign-in you can remove ADMIN_PASSWORD.
# ADMIN_EMAIL=you@example.com
# ADMIN_PASSWORD=
# ADMIN_NAME=Your Name
# Optional: signs sign-in tokens. Without it one is generated and kept in the database.
# JWT_SECRET=
