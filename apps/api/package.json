{
  "name": "@eii/api",
  "version": "0.1.0",
  "private": true,
  "description": "REST API and event ingestion pipeline.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "build": "node build.mjs",
    "start:prod": "node --enable-source-maps dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cli": "tsx --env-file-if-exists=.env src/cli.ts"
  },
  "dependencies": {
    "@eii/shared": "^0.1.0",
    "@electric-sql/pglite": "^0.5.8",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^8.3.0",
    "node-ical": "^0.27.2",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "robots-parser": "^3.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
