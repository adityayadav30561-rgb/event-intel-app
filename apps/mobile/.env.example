# ─────────────────────────────────────────────────────────────────────────────
# PUBLIC, NON-SECRET configuration only. Anything prefixed EXPO_PUBLIC_ is bundled
# into the app and readable by anyone. Database URLs, JWT secrets, VAPID private
# keys and source API keys belong on the server only (apps/api), never here.
# ─────────────────────────────────────────────────────────────────────────────

# Where event data comes from: "mock" (bundled demo data) or "api" (live server, from Phase 2).
EXPO_PUBLIC_DATA_MODE=mock

# Live API base URL (from Phase 2), e.g. https://<your-api>.onrender.com/v1
EXPO_PUBLIC_API_URL=
