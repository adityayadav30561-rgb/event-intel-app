{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "@eii/api"],
      "port": 4000
    },
    {
      "name": "web-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "-w", "@eii/mobile", "--", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "web-dist",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "serve:web", "-w", "@eii/mobile"],
      "port": 4173
    }
  ]
}
